# Base URL of the UI system under test (public TodoMVC demo, no auth required)
BASE_URL=https://todomvc.com/examples/react/dist/

# Base URL of the API system under test (public JSONPlaceholder demo, no auth required)
API_BASE_URL=https://jsonplaceholder.typicode.com

# Whether Playwright launches browsers in headless mode (true/false)
HEADLESS=true
